# ScholarIQ configuration. Copy to .env and adjust.
# No AI provider keys are used or accepted: the API refuses to start if any are set.

SCHOLARIQ_ENVIRONMENT=development
# server (PostgreSQL) or offline (single-user, SQLite)
SCHOLARIQ_DEPLOYMENT_MODE=server

# Used by docker compose for the database container.
POSTGRES_PASSWORD=scholariq
# When running the API outside docker compose:
# SCHOLARIQ_DATABASE_URL=postgresql+psycopg://scholariq:scholariq@localhost:5432/scholariq
# Offline mode example:
# SCHOLARIQ_DATABASE_URL=sqlite:///./var/scholariq.db

# Must be at least 32 random characters in production.
SCHOLARIQ_SECRET_KEY=change-me

SCHOLARIQ_UPLOAD_DIR=./var/uploads
SCHOLARIQ_MAX_UPLOAD_BYTES=10485760
SCHOLARIQ_UPLOAD_RETENTION_DAYS=30
# Tutor conversations are deleted this many days after their last message; 0 keeps them.
SCHOLARIQ_CONVERSATION_RETENTION_DAYS=30
SCHOLARIQ_CONTENT_DIR=../content
# SCHOLARIQ_TESSERACT_CMD=/usr/bin/tesseract

SCHOLARIQ_CORS_ORIGINS=["http://localhost:3000"]
# Build the tutor index at start-up so the first question is fast.
SCHOLARIQ_WARM_CACHES_ON_START=true
SCHOLARIQ_LOG_LEVEL=INFO
SCHOLARIQ_STRICT_AI_ENV_CHECK=true
