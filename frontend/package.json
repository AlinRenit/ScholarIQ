{
  "name": "scholariq-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check app components lib tests e2e playwright.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "^26.1.0",
    "prettier": "3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
